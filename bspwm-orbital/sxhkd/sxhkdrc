# Orbital — atajos (sxhkd). super = tecla Windows.

# ---------- Aplicaciones ----------
super + Return
	kitty

super + d
	rofi -show drun -theme ~/.config/rofi/orbital.rasi

super + shift + f
	firefox

super + shift + b
	burpsuite

Print
	flameshot gui

# ---------- Alternativas sin tecla Windows (VMware a veces no la pasa) ----------
ctrl + alt + {Return,t}
	kitty

alt + {d,F2}
	rofi -show drun -theme ~/.config/rofi/orbital.rasi

alt + F4
	bspc node -c

ctrl + alt + {1-6}
	bspc desktop -f '^{1-6}'

ctrl + alt + {Left,Right}
	bspc desktop -f {prev,next}.local

# clic central en el fondo = abrir terminal; clic derecho = menú de apps
~button2
	bspc query -N -n pointed.window.!below >/dev/null || kitty

~button3
	bspc query -N -n pointed.window.!below >/dev/null || rofi -show drun -theme ~/.config/rofi/orbital.rasi

# ---------- sxhkd / bspwm ----------
# recargar atajos
super + Escape
	pkill -USR1 -x sxhkd

# salir (vuelve a SDDM) / reiniciar bspwm
super + shift + {q,r}
	bspc {quit,wm -r}

# cerrar / matar ventana
super + {_,shift + }w
	bspc node -{c,k}

# alternar monocle (pantalla completa con gaps)
super + m
	bspc desktop -l next

# ---------- Estado de ventanas ----------
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# ---------- Foco y movimiento ----------
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# escritorio 1-6 / mandar ventana al escritorio
super + {_,shift + }{1-6}
	bspc {desktop -f,node -d} '^{1-6}'

# escritorio anterior/siguiente
super + ctrl + {Left,Right}
	bspc desktop -f {prev,next}.local

# ---------- Preselección (dónde se abre la próxima ventana) ----------
super + ctrl + alt + {Left,Down,Up,Right}
	bspc node -p {west,south,north,east}

super + ctrl + alt + space
	bspc node -p cancel

# ---------- Redimensionar ----------
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0 || bspc node -z right -20 0, \
	              bottom 0 20 || bspc node -z top 0 20, \
	              top 0 -20 || bspc node -z bottom 0 -20, \
	              right 20 0 || bspc node -z left 20 0}

# mover ventana flotante
super + shift + alt + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
