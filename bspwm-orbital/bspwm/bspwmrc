#!/bin/sh
# Orbital — bspwm (diseño: https://claude.ai/artifact/EACVk7iA4wJZnFBHtK6u1H)

pgrep -x sxhkd >/dev/null || sxhkd &

bspc monitor -d 1 2 3 4 5 6

# --- Geometría ------------------------------------------------------------
bspc config border_width        2
bspc config window_gap          12
bspc config top_padding         42      # 8 (offset) + 34 (alto de la polybar)
bspc config split_ratio         0.55
bspc config borderless_monocle  true
bspc config gapless_monocle     false
bspc config focus_follows_pointer true
bspc config pointer_follows_focus false

# --- Colores (paleta Orbital) -------------------------------------------
bspc config focused_border_color   '#5b7cfa'
bspc config active_border_color    '#2a3142'
bspc config normal_border_color    '#2a3142'
bspc config presel_feedback_color  '#5b7cfa'

# --- Reglas -------------------------------------------------------------
bspc rule -a firefox          desktop='^2' follow=on
bspc rule -a burp-StartBurp   state=floating
bspc rule -a Wireshark        desktop='^3' follow=on
bspc rule -a flameshot        state=floating
bspc rule -a Pavucontrol      state=floating
# fondo animado: sin gestionar (start.sh lo baja al fondo de la pila)
bspc rule -a '*:*:OrbitalBg'  manage=off

# --- Autostart ----------------------------------------------------------
xsetroot -cursor_name left_ptr &

# Integración VMware (copiar/pegar y ajuste de resolución)
command -v vmware-user-suid-wrapper >/dev/null && vmware-user-suid-wrapper &

# Fondo: el mismo de tu KDE (install.sh lo copia aquí). Si no está, negro.
if [ -f "$HOME/.config/bspwm/wallpaper" ]; then
    feh --no-fehbg --bg-fill "$HOME/.config/bspwm/wallpaper" &
else
    xsetroot -solid '#000000' &
fi

# Fondo animado (la escena del login). La imagen de feh queda de respaldo.
[ -f "$HOME/.config/orbital/background/Background.qml" ] && "$HOME/.config/orbital/background/start.sh" &

pgrep -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" -b
"$HOME/.config/polybar/launch.sh" &

# Al entrar, una terminal con la lista de atajos (para no quedar en un escritorio vacío)
sleep 1 && kitty --hold sh -c 'bash -ic atajos; exec bash' &
